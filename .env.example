# ---------------------------------------------------------------------------
# Cashup — variables d'environnement
# Copiez ce fichier vers `.env` puis complétez les valeurs.
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
# Production (PostgreSQL managé : Neon, Supabase, Railway…)
DATABASE_URL="postgresql://user:password@host:5432/cashup?sslmode=require"
# Dev local (SQLite généré automatiquement) : `file:./dev.db`

# --- Sécurité --------------------------------------------------------------
# Clé de signature des sessions de connexion (32+ caractères aléatoires).
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="remplacer-par-une-chaine-secrete-longue-et-aleatoire"
# En production, la CSP exige HTTPS (HSTS est déjà envoyé).

# --- Notifications par e-mail (choisir UN fournisseur) ---------------------
# Option A — Resend (https://resend.com)
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Option B — Brevo (ex-Sendinblue, https://www.brevo.com)
# BREVO_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
# Adresse d'expéditeur affichée (format « Nom <adresse> » accepté)
# EMAIL_FROM="Cashup <bonjour@cashup.bj>"

# --- Notifications par SMS -------------------------------------------------
# Option A — Twilio (https://www.twilio.com)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_FROM="+229970000000"
#
# Sans fournisseur e-mail/SMS configuré, les messages restent « En file
# d'attente » dans l'administration (/admin/outbox) : rien n'est perdu.

# --- Compte administrateur initial ----------------------------------------
# Utilisé par `npm run admin:setup` en production.
# ADMIN_EMAIL="admin@cashup.bj"
# ADMIN_PASSWORD="un-mot-de-passe-robuste"
